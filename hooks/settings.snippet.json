{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "holdfast hook PreToolUse",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "holdfast hook PostToolUse",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "holdfast hook PostToolUseFailure",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "holdfast hook UserPromptSubmit",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "holdfast hook SessionStart",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "holdfast hook SubagentStart",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "holdfast hook PreCompact",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
